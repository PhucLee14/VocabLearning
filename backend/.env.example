# Copy to .env and fill in real values. NEVER commit .env.

# Neon – pooled connection (host contains "-pooler"), used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# Neon – direct connection (host WITHOUT "-pooler"), used by prisma migrate/seed
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

PORT=4300
# Frontend origin(s) allowed to call the API (comma-separate multiple origins).
# The FIRST one is also the public origin used for redirects, e.g. the Google callback.
# Production (Vercel env of the backend project): https://godee.vercel.app
FRONTEND_URL="http://localhost:3300"

GOOGLE_CLIENT_ID="xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"

# Email (confirmation codes). Gmail SMTP with an App Password for now:
# Google account → Security → 2-Step Verification → App passwords.
# Without SMTP_HOST, outside production emails are only written to the log; in production sending fails (503).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="you@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
MAIL_FROM="Godee <you@gmail.com>"

# Bearer token for scheduled/ops endpoints (/api/health/db now, /api/cron/* later).
# Generate with: openssl rand -hex 32
CRON_SECRET=""
